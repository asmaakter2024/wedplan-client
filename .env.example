# Next.js and Better Auth (client project)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Must match the Express backend JWT_SECRET
JWT_SECRET=replace-with-the-same-secret-used-by-the-backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Google OAuth. Enable only after configuring Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
